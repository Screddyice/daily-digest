# Corpus DB (health section). The digest reads health_metrics via
# shawn_corpus.KnowledgeClient; RDS_URL is the standard corpus DSN name.
# Omit it to drop the You section (e.g. a sandbox with no DB).
# RDS_URL=postgresql://shawn_jarvis:...@127.0.0.1:5432/postgres?sslmode=disable
# Legacy HAE settings (server removed 2026-08-21) — no longer read:
# back to the connector JSON at ~/.openjarvis/connectors/apple_health_remote.json.
# HAE_BASE_URL=https://<your-hae>.trycloudflare.com
# HAE_READ_TOKEN=sk-xxxxxxxx
# HAE_CONNECTOR_JSON=/home/ubuntu/.openjarvis/connectors/apple_health_remote.json

# Fi collar (Bella) — unofficial API, plain account login.
FI_EMAIL=you@example.com
FI_PASSWORD=xxxxxxxx
# FI_PET_NAME=Bella
# bella_sync.py also requires RDS_URL above so it can write source=fi rows.

# Top 5 (NEBOS) + meetings — Composio REST gateway for Linear + Gmail + Calendar.
# NEB_COMPOSIO_MCP_API_KEY=xxxxxxxx
# NEB_COMPOSIO_MCP_USER_ID=user_uwgmr
# NEBOS_COMPANY_DOMAIN=teamnebula.ai   # mail from this domain counts as internal
# Client domains — only mail from these counts as a "client email to reply to".
# Defaults to rivus.mx,newcalgon.net,rs21.io; add more as the client list grows.
# NEBOS_CLIENT_DOMAINS=rivus.mx,newcalgon.net,rs21.io
# Call Retro: pin the call recap to a specific meeting by title (matches the
# Gemini notes doc name). Default: newest "Notes by Gemini" doc.
# NEBOS_RETRO_MEETING=Call Retro

# Slack delivery (omit to print instead of post; DRY_RUN=1 also prints).
# SLACK_BOT_TOKEN=xoxb-xxxxxxxx
# SLACK_CHANNEL=DXXXXXXXX
