[Unit]
Description=Morning digest — Top5 + health (corpus) + Bella + meetings -> Shawn DM
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/daily-digest
EnvironmentFile=%h/daily-digest/.env
# shawn-corpus venv: health.py imports shawn_corpus.KnowledgeClient (psycopg)
# to read health_metrics next to the DB. Everything else in the digest is
# stdlib, so this is the only interpreter requirement.
ExecStart=%h/shawn-corpus/.venv/bin/python3 morning.py
StandardOutput=journal
StandardError=journal
